# ocmake.lock -- resolved URLs and hashes, committed so builds are reproducible.
#
# Format is a CMake script of oc_lock() calls: reading it is include(), writing it is
# string concatenation, and it stays diffable. Same reasoning as the staging manifest
# (PLAN.md §3.2) -- the only consumer is CMake.
#
# A warm lock means a build makes zero GitHub API calls, which is what keeps the
# unauthenticated 60 req/hour limit from ever being reached (PLAN.md §7).

set(OC_LOCKFILE "${CMAKE_SOURCE_DIR}/ocmake.lock" CACHE FILEPATH "OCMake lockfile")
option(OC_UPDATE  "Re-resolve every pinned item, ignoring ocmake.lock" OFF)
option(OC_OFFLINE "Never hit the network; fail if the lock or cache is cold" OFF)

# Property names cannot carry arbitrary punctuation reliably, so keys are tokenised.
function(_oc_lock_token key out)
  string(REGEX REPLACE "[^A-Za-z0-9]" "_" t "${key}")
  set(${out} "${t}" PARENT_SCOPE)
endfunction()

# Called by the lockfile itself.
function(oc_lock)
  cmake_parse_arguments(A "" "KEY;VERSION;BUILD;URL;SHA256" "" ${ARGN})
  _oc_lock_token("${A_KEY}" tok)
  set_property(GLOBAL PROPERTY OC_LOCK_${tok}_KEY     "${A_KEY}")
  set_property(GLOBAL PROPERTY OC_LOCK_${tok}_VERSION "${A_VERSION}")
  set_property(GLOBAL PROPERTY OC_LOCK_${tok}_BUILD   "${A_BUILD}")
  set_property(GLOBAL PROPERTY OC_LOCK_${tok}_URL     "${A_URL}")
  set_property(GLOBAL PROPERTY OC_LOCK_${tok}_SHA256  "${A_SHA256}")
  set_property(GLOBAL APPEND PROPERTY OC_LOCK_KNOWN "${A_KEY}")
endfunction()

function(_oc_lock_load)
  get_property(loaded GLOBAL PROPERTY OC_LOCK_LOADED)
  if(loaded)
    return()
  endif()
  set_property(GLOBAL PROPERTY OC_LOCK_LOADED TRUE)
  if(EXISTS "${OC_LOCKFILE}" AND NOT OC_UPDATE)
    include("${OC_LOCKFILE}")
    _oc_info("lockfile: ${OC_LOCKFILE}")
  elseif(OC_UPDATE)
    _oc_info("OC_UPDATE=ON -- re-resolving everything")
  endif()
endfunction()

# _oc_lock_get(<key> <out_version> <out_build> <out_url> <out_sha256>) -> sets them empty if absent
function(_oc_lock_get key out_v out_b out_u out_s)
  _oc_lock_load()
  _oc_lock_token("${key}" tok)
  get_property(k GLOBAL PROPERTY OC_LOCK_${tok}_KEY)
  if(NOT k STREQUAL "${key}")
    set(${out_v} "" PARENT_SCOPE)
    set(${out_b} "" PARENT_SCOPE)
    set(${out_u} "" PARENT_SCOPE)
    set(${out_s} "" PARENT_SCOPE)
    return()
  endif()
  get_property(v GLOBAL PROPERTY OC_LOCK_${tok}_VERSION)
  get_property(b GLOBAL PROPERTY OC_LOCK_${tok}_BUILD)
  get_property(u GLOBAL PROPERTY OC_LOCK_${tok}_URL)
  get_property(s GLOBAL PROPERTY OC_LOCK_${tok}_SHA256)
  set(${out_v} "${v}" PARENT_SCOPE)
  set(${out_b} "${b}" PARENT_SCOPE)
  set(${out_u} "${u}" PARENT_SCOPE)
  set(${out_s} "${s}" PARENT_SCOPE)
endfunction()

function(_oc_lock_set key version build url sha256)
  _oc_lock_token("${key}" tok)
  set_property(GLOBAL PROPERTY OC_LOCK_${tok}_KEY     "${key}")
  set_property(GLOBAL PROPERTY OC_LOCK_${tok}_VERSION "${version}")
  set_property(GLOBAL PROPERTY OC_LOCK_${tok}_BUILD   "${build}")
  set_property(GLOBAL PROPERTY OC_LOCK_${tok}_URL     "${url}")
  set_property(GLOBAL PROPERTY OC_LOCK_${tok}_SHA256  "${sha256}")
  set_property(GLOBAL APPEND PROPERTY OC_LOCK_USED "${key}")
endfunction()

# Write back the entries used this configure, plus any existing entry belonging to a
# *different* build variant.
#
# Pruning everything unused looked tidy but broke the documented workflow of keeping a
# Release and a Debug build directory side by side (§2): each configure deleted the other
# variant's entries, so every switch re-resolved every item from the GitHub API -- twelve
# calls per switch for the b760i example, which is what exhausted the 60/hour limit during
# development. Entries for the current variant are still pruned, so removing a kext still
# removes its line.
function(_oc_lock_flush)
  get_property(used GLOBAL PROPERTY OC_LOCK_USED)
  if(NOT used)
    return()
  endif()
  get_property(known GLOBAL PROPERTY OC_LOCK_KNOWN)
  foreach(key IN LISTS known)
    if(NOT key IN_LIST used)
      _oc_lock_token("${key}" tok)
      get_property(b GLOBAL PROPERTY OC_LOCK_${tok}_BUILD)
      if(NOT b STREQUAL "${OC_BUILD}")
        list(APPEND used "${key}")
      endif()
    endif()
  endforeach()
  list(REMOVE_DUPLICATES used)
  list(SORT used)
  set(body "# ocmake.lock -- generated by OCMake ${OCMAKE_VERSION}. Commit this file.\n")
  string(APPEND body "# Refresh with -DOC_UPDATE=ON. Build without network with -DOC_OFFLINE=ON.\n\n")
  foreach(key IN LISTS used)
    _oc_lock_token("${key}" tok)
    get_property(v GLOBAL PROPERTY OC_LOCK_${tok}_VERSION)
    get_property(b GLOBAL PROPERTY OC_LOCK_${tok}_BUILD)
    get_property(u GLOBAL PROPERTY OC_LOCK_${tok}_URL)
    get_property(s GLOBAL PROPERTY OC_LOCK_${tok}_SHA256)
    string(APPEND body "oc_lock(KEY \"${key}\"\n")
    string(APPEND body "        VERSION \"${v}\"\n")
    string(APPEND body "        BUILD \"${b}\"\n")
    string(APPEND body "        URL \"${u}\"\n")
    string(APPEND body "        SHA256 \"${s}\")\n")
  endforeach()

  set(old "")
  if(EXISTS "${OC_LOCKFILE}")
    file(READ "${OC_LOCKFILE}" old)
  endif()
  if(NOT old STREQUAL body)
    file(WRITE "${OC_LOCKFILE}" "${body}")
    _oc_info("wrote ${OC_LOCKFILE}")
  endif()
endfunction()
